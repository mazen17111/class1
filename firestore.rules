rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints
    function isValidStudent(data, studentId) {
      return data.keys().hasAll(['id', 'name', 'avatarColor', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'avatarColor', 'createdAt'])
        && data.id is string && isValidId(data.id) && data.id == studentId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.avatarColor is string && data.avatarColor.size() >= 4 && data.avatarColor.size() <= 20
        && data.createdAt is timestamp;
    }

    function isValidCertificate(data, certId) {
      return data.keys().hasAll([
          'id', 'studentId', 'studentName', 'studentAvatarColor',
          'letterId', 'letterChar', 'letterName', 'score', 'total',
          'percentage', 'themeId', 'issuedDateLabel', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentId', 'studentName', 'studentAvatarColor',
          'letterId', 'letterChar', 'letterName', 'score', 'total',
          'percentage', 'themeId', 'issuedDateLabel', 'createdAt', 'updatedAt'
        ])
        && data.id is string && isValidId(data.id) && data.id == certId
        && data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100
        && data.studentAvatarColor is string && data.studentAvatarColor.size() >= 4 && data.studentAvatarColor.size() <= 20
        && data.letterId is string && data.letterId.size() >= 1 && data.letterId.size() <= 40
        && data.letterChar is string && data.letterChar.size() >= 1 && data.letterChar.size() <= 10
        && data.letterName is string && data.letterName.size() >= 1 && data.letterName.size() <= 40
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.total is number && data.total >= 1 && data.total <= 100
        && data.percentage is number && data.percentage >= 0 && data.percentage <= 100
        && data.themeId is string && data.themeId.size() >= 1 && data.themeId.size() <= 40
        && data.issuedDateLabel is string && data.issuedDateLabel.size() >= 1 && data.issuedDateLabel.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomWord(data, wordId) {
      return data.keys().hasAll([
          'id', 'word', 'cleanWord', 'targetLetter',
          'position', 'maddType', 'image', 'isCustom', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'word', 'cleanWord', 'targetLetter',
          'position', 'maddType', 'shortVowel', 'image', 'meaning', 'isCustom', 'createdAt'
        ])
        && data.id is string && isValidId(data.id) && data.id == wordId
        && data.word is string && data.word.size() >= 1 && data.word.size() <= 80
        && data.cleanWord is string && data.cleanWord.size() >= 1 && data.cleanWord.size() <= 80
        && data.targetLetter is string && data.targetLetter.size() >= 1 && data.targetLetter.size() <= 10
        && data.position is string && data.position in ['beginning', 'middle', 'end', 'isolated']
        && data.maddType is string && data.maddType in ['none', 'alif', 'waw', 'yaa']
        && (!('shortVowel' in data) || (data.shortVowel is string && data.shortVowel in ['fatha', 'damma', 'kasra', 'sukoon']))
        && data.image is string && data.image.size() <= 500000
        && (!('meaning' in data) || (data.meaning is string && data.meaning.size() <= 120))
        && data.isCustom is bool && data.isCustom == true
        && data.createdAt is timestamp;
    }

    // 4. Direct Classroom Collections (No Login Required; Zero PII)

    // Permanent Students (Deletions strictly forbidden)
    match /students/{studentId} {
      allow get: if isValidId(studentId);
      allow list: if true;

      allow create: if isValidId(studentId)
        && isValidStudent(incoming(), studentId)
        && incoming().createdAt == request.time;

      allow update: if isValidId(studentId)
        && isValidStudent(incoming(), studentId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarColor']);

      allow delete: if isValidId(studentId);
    }

    // Permanent Issued Certificates Archive
    match /certificates/{certId} {
      allow get: if isValidId(certId);
      allow list: if true;

      allow create: if isValidId(certId)
        && isValidCertificate(incoming(), certId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(certId)
        && isValidCertificate(incoming(), certId)
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().score == existing().score
        && incoming().total == existing().total
        && incoming().percentage == existing().percentage
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['themeId', 'updatedAt']);

      allow delete: if isValidId(certId);
    }

    // Teacher Custom Words & Compressed Images
    match /customWords/{wordId} {
      allow get: if isValidId(wordId);
      allow list: if true;

      allow create: if isValidId(wordId)
        && isValidCustomWord(incoming(), wordId)
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isValidId(wordId);
    }

    function isValidBranding(data) {
      return data.keys().hasAll(['id', 'logoUrl', 'updatedAt'])
        && data.keys().hasOnly(['id', 'logoUrl', 'badgeChar', 'badgeColor', 'updatedAt'])
        && data.id is string && data.id == 'branding'
        && data.logoUrl is string && data.logoUrl.size() <= 500000
        && (!('badgeChar' in data) || (data.badgeChar is string && data.badgeChar.size() >= 1 && data.badgeChar.size() <= 10))
        && (!('badgeColor' in data) || (data.badgeColor is string && data.badgeColor.size() >= 4 && data.badgeColor.size() <= 20))
        && data.updatedAt is timestamp;
    }

    // Platform Branding Settings (Logo, Letter, Color)
    match /settings/{settingId} {
      allow get: if settingId == 'branding';
      allow list: if false;

      allow create: if settingId == 'branding'
        && isValidBranding(incoming())
        && incoming().updatedAt == request.time;

      allow update: if settingId == 'branding'
        && isValidBranding(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['logoUrl', 'badgeChar', 'badgeColor', 'updatedAt']);

      allow delete: if false;
    }

    function isValidStudyMaterial(data, materialId) {
      return data.keys().hasAll([
          'id', 'title', 'sourceType', 'fileUrl', 'pageCount', 'lastPage', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'sourceType', 'fileUrl', 'inlineImage', 'pageCount', 'lastPage', 'createdAt', 'updatedAt'
        ])
        && data.id is string && isValidId(data.id) && data.id == materialId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.sourceType is string && data.sourceType in ['pdf_file', 'image_file', 'url']
        && data.fileUrl is string && data.fileUrl.size() <= 2000
        && (!('inlineImage' in data) || (data.inlineImage is string && data.inlineImage.size() <= 500000))
        && data.pageCount is number && data.pageCount >= 1 && data.pageCount <= 2000
        && data.lastPage is number && data.lastPage >= 1 && data.lastPage <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMaterialAnnotation(data, materialId, pageKey) {
      return data.keys().hasAll(['id', 'materialId', 'pageNumber', 'imageData', 'updatedAt'])
        && data.keys().hasOnly(['id', 'materialId', 'pageNumber', 'imageData', 'updatedAt'])
        && data.id is string && isValidId(data.id) && data.id == pageKey && data.id.size() <= 40
        && data.materialId is string && isValidId(data.materialId) && data.materialId == materialId
        && data.pageNumber is number && data.pageNumber >= 1 && data.pageNumber <= 2000
        && data.imageData is string && data.imageData.size() <= 500000
        && data.updatedAt is timestamp;
    }

    // Classroom Study Materials & Page Annotations
    match /studyMaterials/{materialId} {
      allow get: if isValidId(materialId);
      allow list: if true;

      allow create: if isValidId(materialId)
        && isValidStudyMaterial(incoming(), materialId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(materialId)
        && isValidStudyMaterial(incoming(), materialId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'pageCount', 'lastPage', 'updatedAt']);

      allow delete: if isValidId(materialId);

      match /annotations/{pageKey} {
        allow get: if isValidId(materialId) && isValidId(pageKey);
        allow list: if isValidId(materialId);

        allow create: if isValidId(materialId)
          && isValidId(pageKey)
          && isValidMaterialAnnotation(incoming(), materialId, pageKey)
          && exists(/databases/$(database)/documents/studyMaterials/$(materialId))
          && incoming().updatedAt == request.time;

        allow update: if isValidId(materialId)
          && isValidId(pageKey)
          && isValidMaterialAnnotation(incoming(), materialId, pageKey)
          && exists(/databases/$(database)/documents/studyMaterials/$(materialId))
          && incoming().id == existing().id
          && incoming().materialId == existing().materialId
          && incoming().pageNumber == existing().pageNumber
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['imageData', 'updatedAt']);

        allow delete: if isValidId(materialId) && isValidId(pageKey);
      }
    }

    function isValidDeckTheme(t) {
      return t is map
        && t.keys().hasAll([
          'id', 'name', 'primaryHex', 'secondaryHex', 'accentHex',
          'bgHex', 'surfaceHex', 'borderHex', 'textHex', 'mutedTextHex', 'patternType'
        ])
        && t.keys().hasOnly([
          'id', 'name', 'primaryHex', 'secondaryHex', 'accentHex',
          'bgHex', 'surfaceHex', 'borderHex', 'textHex', 'mutedTextHex', 'patternType'
        ])
        && t.id is string && t.id.size() >= 1 && t.id.size() <= 40
        && t.name is string && t.name.size() >= 1 && t.name.size() <= 80
        && t.primaryHex is string && t.primaryHex.size() <= 20
        && t.secondaryHex is string && t.secondaryHex.size() <= 20
        && t.accentHex is string && t.accentHex.size() <= 20
        && t.bgHex is string && t.bgHex.size() <= 20
        && t.surfaceHex is string && t.surfaceHex.size() <= 20
        && t.borderHex is string && t.borderHex.size() <= 20
        && t.textHex is string && t.textHex.size() <= 20
        && t.mutedTextHex is string && t.mutedTextHex.size() <= 20
        && t.patternType is string && t.patternType in ['waves', 'geometric', 'diagonal', 'arches', 'ribbons', 'dots'];
    }

    function isValidPresentation(data, presentationId) {
      return data.keys().hasAll([
          'id', 'title', 'letterId', 'letterChar', 'letterName',
          'slideCount', 'transitionEnabled', 'transitionType', 'theme', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'letterId', 'letterChar', 'letterName',
          'slideCount', 'transitionEnabled', 'transitionType', 'theme',
          'isExternal', 'externalType', 'externalUrl', 'createdAt', 'updatedAt'
        ])
        && data.id is string && isValidId(data.id) && data.id == presentationId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.letterId is string && data.letterId.size() >= 1 && data.letterId.size() <= 40
        && data.letterChar is string && data.letterChar.size() >= 1 && data.letterChar.size() <= 10
        && data.letterName is string && data.letterName.size() >= 1 && data.letterName.size() <= 40
        && data.slideCount is number && data.slideCount >= 1 && data.slideCount <= 100
        && data.transitionEnabled is bool
        && data.transitionType is string && data.transitionType in ['none', 'fade', 'slide', 'zoom', 'flip', 'curtain', 'cube']
        && (!('isExternal' in data) || data.isExternal is bool)
        && (!('externalType' in data) || (data.externalType is string && data.externalType in ['pptx_file', 'pdf_slides', 'embed_url']))
        && (!('externalUrl' in data) || (data.externalUrl is string && data.externalUrl.size() <= 2000))
        && isValidDeckTheme(data.theme)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPresentationSlide(data, presentationId, slideKey) {
      return data.keys().hasAll(['id', 'presentationId', 'slideIndex', 'slideData', 'updatedAt'])
        && data.keys().hasOnly(['id', 'presentationId', 'slideIndex', 'slideData', 'updatedAt'])
        && data.id is string && isValidId(data.id) && data.id == slideKey && data.id.size() <= 40
        && data.presentationId is string && isValidId(data.presentationId) && data.presentationId == presentationId
        && data.slideIndex is number && data.slideIndex >= 0 && data.slideIndex <= 100
        && data.slideData is map
        && data.slideData.keys().hasAll(['id', 'kind', 'layoutVariant', 'title', 'subtitle', 'items', 'teacherNote'])
        && data.slideData.keys().hasOnly([
          'id', 'kind', 'layoutVariant', 'title', 'subtitle', 'badgeText',
          'highlightLetter', 'bodyText', 'items', 'uploadedImages', 'teacherNote',
          'textAlign', 'headerLetterSide', 'columnsOverride', 'fontScale', 'swapPositions',
          'fullBleedImage'
        ])
        && data.slideData.id is string && data.slideData.id.size() >= 1 && data.slideData.id.size() <= 128
        && data.slideData.title is string && data.slideData.title.size() <= 300
        && data.slideData.subtitle is string && data.slideData.subtitle.size() <= 500
        && data.slideData.items is list && data.slideData.items.size() <= 50
        && (!('fullBleedImage' in data.slideData) || data.slideData.fullBleedImage is bool)
        && data.updatedAt is timestamp;
    }

    function isValidPresentationAnnotation(data, presentationId, annKey) {
      return data.keys().hasAll(['id', 'presentationId', 'slideIndex', 'imageData', 'updatedAt'])
        && data.keys().hasOnly(['id', 'presentationId', 'slideIndex', 'imageData', 'updatedAt'])
        && data.id is string && isValidId(data.id) && data.id == annKey && data.id.size() <= 40
        && data.presentationId is string && isValidId(data.presentationId) && data.presentationId == presentationId
        && data.slideIndex is number && data.slideIndex >= 0 && data.slideIndex <= 100
        && data.imageData is string && data.imageData.size() <= 500000
        && data.updatedAt is timestamp;
    }

    // Saved Teacher PowerPoint Presentations, Slides & Explainer Annotations
    match /presentations/{presentationId} {
      allow get: if isValidId(presentationId);
      allow list: if true;

      allow create: if isValidId(presentationId)
        && isValidPresentation(incoming(), presentationId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(presentationId)
        && isValidPresentation(incoming(), presentationId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'letterId', 'letterChar', 'letterName',
          'slideCount', 'transitionEnabled', 'transitionType', 'theme',
          'isExternal', 'externalType', 'externalUrl', 'updatedAt'
        ]);

      allow delete: if isValidId(presentationId);

      match /slides/{slideKey} {
        allow get: if isValidId(presentationId) && isValidId(slideKey);
        allow list: if isValidId(presentationId);

        allow create: if isValidId(presentationId)
          && isValidId(slideKey)
          && isValidPresentationSlide(incoming(), presentationId, slideKey)
          && exists(/databases/$(database)/documents/presentations/$(presentationId))
          && incoming().updatedAt == request.time;

        allow update: if isValidId(presentationId)
          && isValidId(slideKey)
          && isValidPresentationSlide(incoming(), presentationId, slideKey)
          && exists(/databases/$(database)/documents/presentations/$(presentationId))
          && incoming().id == existing().id
          && incoming().presentationId == existing().presentationId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['slideIndex', 'slideData', 'updatedAt']);

        allow delete: if isValidId(presentationId) && isValidId(slideKey);
      }

      match /annotations/{annKey} {
        allow get: if isValidId(presentationId) && isValidId(annKey);
        allow list: if isValidId(presentationId);

        allow create: if isValidId(presentationId)
          && isValidId(annKey)
          && isValidPresentationAnnotation(incoming(), presentationId, annKey)
          && exists(/databases/$(database)/documents/presentations/$(presentationId))
          && incoming().updatedAt == request.time;

        allow update: if isValidId(presentationId)
          && isValidId(annKey)
          && isValidPresentationAnnotation(incoming(), presentationId, annKey)
          && exists(/databases/$(database)/documents/presentations/$(presentationId))
          && incoming().id == existing().id
          && incoming().presentationId == existing().presentationId
          && incoming().slideIndex == existing().slideIndex
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['imageData', 'updatedAt']);

        allow delete: if isValidId(presentationId) && isValidId(annKey);
      }
    }
  }
}
